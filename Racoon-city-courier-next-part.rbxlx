			<Item class="ModuleScript" referent="RBX3E343B59A6164A788CA49E08F3D91710">
				<Properties>
					<Content name="LinkedSource"><null></null></Content>
					<ProtectedString name="Source"><![CDATA[-- New script created by Ropilot
-- Replace this with your code
-- Shared tuning. Ammo belongs to the server and persists through character respawns.
local Config = {
	MagazineSize = 4,
	StartingMagazine = 4,
	StartingReserve = 4,
	MaxReserve = 24,
	ReloadSeconds = 5.5,
	ReloadAnimationSeconds = 5.5,
	ReloadBlendSeconds = 0.18,
	ReloadWalkSpeed = 6,
	ShotInterval = 0.8,
	Damage = 34,
	HeadshotMultiplier = 1.5,
	DamagePlayers = false,
	Range = 240,
	CameraDistance = 7,
	CameraOffset = Vector3.new(2, 0.65, 0),
	AimCameraOffset = Vector3.new(1.65, 0.5, 0),
	FieldOfView = 72,
	AimFieldOfView = 60,
	MouseSensitivity = 0.0025,
	GamepadSensitivity = 2.2,
	CameraCollisionRadius = 0.35,
	IdleSwayDegrees = 1.6,
	MovingSwayDegrees = 6.5,
	MoveSpeedReference = 12,
	RecoilDegrees = 4,
	Grip = CFrame.new(0, -0.25, 0) * CFrame.Angles(-math.pi / 2, 0, 0),
	MuzzleOffset = Vector3.new(0.65, -0.6, 1.25),
}
function Config.Sway(now, speed)
	local movement = math.clamp(speed / Config.MoveSpeedReference, 0, 1)
	local amplitude = math.rad(Config.IdleSwayDegrees
		+ (Config.MovingSwayDegrees - Config.IdleSwayDegrees) * movement)
	local pitch = amplitude * (math.sin(now * 2.3) * 0.6 + math.sin(now * 5.7) * 0.4)
	local yaw = amplitude * (math.sin(now * 1.7 + 1.2) * 0.65 + math.sin(now * 4.3) * 0.35)
	return pitch, yaw
end
function Config.ShotDirection(direction, now, speed)
	local pitch, yaw = Config.Sway(now, speed)
	return (CFrame.lookAt(Vector3.zero, direction)
		* CFrame.Angles(pitch, yaw, 0)).LookVector
end
-- Aim pose and legacy R6 fallback; R15 reloads use PistolReloadFluid.
Config.ReloadPoses = {
	{0.00, {78,0,-8,12,0,0}, {70,12,25,35,0,0}},
	{0.14, {38,-12,-18,38,-12,-15}, {20,0,18,65,0,0}},
	{0.31, {42,-10,-22,48,-18,-20}, {60,24,36,70,10,0}},
	{0.40, {32,-15,-25,40,8,10}, {30,5,20,30,-15,0}},
	{0.51, {40,-10,-20,45,-12,-15}, {62,20,32,72,10,0}},
	{0.68, {42,-8,-20,45,-12,-15}, {65,20,30,60,0,0}},
	{0.76, {30,-5,-16,38,15,8}, {48,12,24,48,-20,0}},
	{0.85, {55,0,-12,28,-5,-8}, {72,18,28,48,10,0}},
	{1.00, {78,0,-8,12,0,0}, {70,12,25,35,0,0}},
}
return Config
]]></ProtectedString>
