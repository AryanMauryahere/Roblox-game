					<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
					<bool name="DefinesCapabilities">false</bool>
					<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
					<string name="Name">CourierHUD</string>
					<int64 name="SourceAssetId">-1</int64>
					<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
					<UniqueId name="UniqueId">18995f86a04e87cbf7745897145ddfee</UniqueId>
				</Properties>
			</Item>
			<Item class="LocalScript" referent="RBX4B6771CFDE434DEFA4B894A083B5AEEB">
				<Properties>
					<ProtectedString name="Source"><![CDATA[-- New script created by Ropilot
-- Replace this with your code
-- Local weather follows the camera, including after respawn/camera replacement.
local RunService = game:GetService("RunService")
local SETTINGS = {
	Volume = Vector3.new(34, 2, 34),
	Offset = Vector3.new(0, 10, -8),
	Rate = 650,
	Wind = Vector3.new(12, -16, 3),
}
local holder = Instance.new("Part")
holder.Name = "BlizzardVolume"
holder.Size = SETTINGS.Volume
holder.Transparency = 1
holder.Anchored = true
holder.CanCollide = false
holder.CanTouch = false
holder.CanQuery = false
holder.CastShadow = false

local snow = Instance.new("ParticleEmitter")
snow.Name = "Blizzard"
snow.Texture = "rbxasset://textures/particles/sparkles_main.dds"
snow.Color = ColorSequence.new(Color3.fromRGB(227, 239, 255))
snow.Size = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.12),
	NumberSequenceKeypoint.new(0.5, 0.2),
	NumberSequenceKeypoint.new(1, 0.08),
})
snow.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 1),
	NumberSequenceKeypoint.new(0.12, 0.15),
	NumberSequenceKeypoint.new(0.8, 0.3),
	NumberSequenceKeypoint.new(1, 1),
})
snow.Lifetime = NumberRange.new(1.4, 2.4)
snow.Rate = SETTINGS.Rate
snow.Speed = NumberRange.new(14, 22)
snow.EmissionDirection = Enum.NormalId.Bottom
snow.SpreadAngle = Vector2.new(25, 25)
snow.Acceleration = SETTINGS.Wind
snow.Rotation = NumberRange.new(0, 360)
snow.RotSpeed = NumberRange.new(-80, 80)
snow.LightEmission = 0.25
snow.LightInfluence = 0
snow.LockedToPart = false
snow.Parent = holder

local function update()
	local camera = workspace.CurrentCamera
	if not camera then
		holder.Parent = nil
		return
	end
	if holder.Parent ~= camera then
		holder.Parent = camera
		snow:Clear()
	end
	-- Translate with view direction, but keep snowfall aligned with world gravity.
	holder.CFrame = CFrame.new(camera.CFrame:PointToWorldSpace(SETTINGS.Offset))
end
update()
RunService:BindToRenderStep("CameraBlizzard", Enum.RenderPriority.Camera.Value + 1, update)
script.Destroying:Connect(function()
	RunService:UnbindFromRenderStep("CameraBlizzard")
	holder:Destroy()
end)
]]></ProtectedString>
