			<Properties>
				<ProtectedString name="Source"><![CDATA[-- New script created by Ropilot
-- Replace this with your code
-- Snowy mountain lighting. Tune the settings here for the whole place.
local Lighting = game:GetService("Lighting")
local SETTINGS = {
	ClockTime = 17.8,
	Brightness = 0.7,
	Ambient = Color3.fromRGB(10, 16, 35),
	OutdoorAmbient = Color3.fromRGB(10, 16, 35),
	FogColor = Color3.fromRGB(168, 184, 199),
	FogStart = 0,
	FogEnd = 95,
	ExposureCompensation = -0.6,
}
for property, value in pairs(SETTINGS) do
	Lighting[property] = value
end
Lighting.GlobalShadows = false

-- Atmosphere controls visible fog while present; FogStart/End are fallback values.
local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
atmosphere.Name = "Atmosphere"
atmosphere.Density = 0.62
atmosphere.Offset = -0.15
atmosphere.Color = SETTINGS.FogColor
atmosphere.Decay = Color3.fromRGB(90, 108, 130)
atmosphere.Glare = 0
atmosphere.Haze = 4
atmosphere.Parent = Lighting

local grade = Lighting:FindFirstChild("SnowyMountainGrade") or Instance.new("ColorCorrectionEffect")
grade.Name = "SnowyMountainGrade"
grade.Brightness = -0.04
grade.Contrast = 0.12
grade.Saturation = -0.35
grade.TintColor = Color3.fromRGB(205, 224, 245)
grade.Parent = Lighting
local rays = Lighting:FindFirstChildOfClass("SunRaysEffect")
if rays then
	rays.Intensity = 0
end
]]></ProtectedString>
