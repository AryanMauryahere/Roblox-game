					<ProtectedString name="Source"><![CDATA[-- New script created by Ropilot
-- Replace this with your code
-- Camera flashlight: F / gamepad X / touch. Battery lasts across respawns.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local UserInputService = game:GetService("UserInputService")
local player = Players.LocalPlayer
local SETTINGS = {
	BatterySeconds = 180,
	Brightness = 3,
	Range = 55,
	Angle = 65,
	Offset = CFrame.new(0.35, -0.25, -0.6),
	FlickerInterval = NumberRange.new(3, 8),
	LowBatteryInterval = NumberRange.new(0.5, 2),
	LowBatteryFraction = 0.2,
}
local ACTION = "TogglePlayerFlashlight"
local RENDER = "PlayerFlashlight"
local random = Random.new()
local battery = SETTINGS.BatterySeconds
local switchedOn = true
local untilFlicker = random:NextNumber(3, 8)
local flickerRemaining = 0
local pulseRemaining = 0
local pulseBrightness = 1
local lastPercent = -1

local holder = Instance.new("Part")
holder.Name = "PlayerFlashlightMount"
holder.Size = Vector3.new(0.1, 0.1, 0.1)
holder.Transparency = 1
holder.Anchored = true
holder.CanCollide = false
holder.CanTouch = false
holder.CanQuery = false
holder.CastShadow = false

local light = Instance.new("SpotLight")
light.Name = "Flashlight"
light.Face = Enum.NormalId.Front
light.Color = Color3.fromRGB(231, 239, 255)
light.Brightness = SETTINGS.Brightness
light.Range = SETTINGS.Range
light.Angle = SETTINGS.Angle
light.Shadows = false
light.Enabled = false
light.Parent = holder

local function publishBattery()
	local percent = math.ceil(100 * battery / SETTINGS.BatterySeconds)
	if percent ~= lastPercent then
		lastPercent = percent
		script:SetAttribute("BatteryPercent", percent)
		ContextActionService:SetTitle(ACTION, "Light " .. percent .. "%")
	end
	script:SetAttribute("FlashlightOn", switchedOn and battery > 0)
end

local function toggle(_, state)
	if UserInputService:GetFocusedTextBox() then
		return Enum.ContextActionResult.Pass
	end
	if state == Enum.UserInputState.Begin and battery > 0 then
		switchedOn = not switchedOn
		flickerRemaining = 0
		pulseBrightness = 1
		if not switchedOn then
			light.Enabled = false
		end
		publishBattery()
	end
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction(ACTION, toggle, true, Enum.KeyCode.F, Enum.KeyCode.ButtonX)
ContextActionService:SetPosition(ACTION, UDim2.fromScale(0.72, 0.7))
publishBattery()

local function update(dt)
	local camera = workspace.CurrentCamera
	-- Reattach if the active camera changes.
	holder.Parent = camera
	if camera then
		holder.CFrame = camera.CFrame * SETTINGS.Offset
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local active = camera ~= nil and humanoid ~= nil and humanoid.Health > 0
		and switchedOn and battery > 0
	if not active then
		light.Enabled = false
		return
	end

	battery = math.max(0, battery - dt)
	if battery == 0 then
		switchedOn = false
		light.Enabled = false
		publishBattery()
		return
	end

	local fraction = battery / SETTINGS.BatterySeconds
	untilFlicker = untilFlicker - dt
	if untilFlicker <= 0 then
		flickerRemaining = random:NextNumber(0.15, 0.65)
		pulseRemaining = 0
		local interval = fraction <= SETTINGS.LowBatteryFraction
			and SETTINGS.LowBatteryInterval or SETTINGS.FlickerInterval
		untilFlicker = flickerRemaining + random:NextNumber(interval.Min, interval.Max)
	end
	if flickerRemaining > 0 then
		flickerRemaining = math.max(0, flickerRemaining - dt)
		pulseRemaining = pulseRemaining - dt
		if pulseRemaining <= 0 then
			pulseBrightness = random:NextNumber() < 0.45 and 0 or random:NextNumber(0.15, 0.85)
			pulseRemaining = random:NextNumber(0.035, 0.09)
		end
	else
		pulseBrightness = 1
	end

	light.Enabled = true
	light.Brightness = SETTINGS.Brightness * (0.4 + 0.6 * fraction) * pulseBrightness
	publishBattery()
end
RunService:BindToRenderStep(RENDER, Enum.RenderPriority.Camera.Value + 2, update)
script.Destroying:Connect(function()
	RunService:UnbindFromRenderStep(RENDER)
	ContextActionService:UnbindAction(ACTION)
	holder:Destroy()
end)
]]></ProtectedString>
