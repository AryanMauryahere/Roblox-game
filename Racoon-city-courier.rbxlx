				<ProtectedString name="Source"><![CDATA[-- New script created by Ropilot
-- Replace this with your code
-- Server-only tuning for the single hospital mutant.
return {
	HospitalName = "HospitalFogGreybox",
	TemplateName = "HospitalMutantTemplate",
	NPCName = "MutantZombie",
	DetectionRadius = 40,
	PatrolSpeed = 7,
	ChaseSpeed = 24,
	MaxHealth = 180,
	ChaseMemorySeconds = 10,
	AttackRange = 3.5,
	AttackDamage = 15,
	AttackCooldown = 1.4,
	ThinkInterval = 0.1,
	RepathInterval = 0.65,
	TargetMovedDistance = 4,
	PathRetrySeconds = 1.5,
	StuckSeconds = 1.8,
	WaypointReachDistance = 1.3,
	PatrolPauseMin = 0.5,
	PatrolPauseMax = 1.5,
	AgentRadius = 1.2,
	AgentHeight = 5,
	WaypointSpacing = 3,
}
]]></ProtectedString>
				<string name="ScriptGuid">{E0951F52-1DF0-4CED-8D63-8F5FBC84AEFA}</string>
				<BinaryString name="AttributesSerialize"></BinaryString>
				<SecurityCapabilities name="Capabilities">0</SecurityCapabilities>
				<bool name="DefinesCapabilities">false</bool>
				<UniqueId name="HistoryId">00000000000000000000000000000000</UniqueId>
				<string name="Name">HospitalMutantConfig</string>
				<int64 name="SourceAssetId">-1</int64>
				<SharedString name="Tags">yuZpQdnvvUBOTYh1jqZ2cA==</SharedString>
				<UniqueId name="UniqueId">08f26afa8e1108a30ad54fa6000012c3</UniqueId>
			</Properties>
		</Item>
		<Item class="Script" referent="RBX31FB8B505C614BE8A74F473CE309EA37">
			<Properties>
				<ProtectedString name="Source"><![CDATA[-- New script created by Ropilot
-- Replace this with your code
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local ServerStorage = game:GetService("ServerStorage")
local Config = require(script.Parent:WaitForChild("HospitalMutantConfig"))
local template = ServerStorage:WaitForChild(Config.TemplateName)
local random = Random.new()
local controllers = {}
local started = setmetatable({}, {__mode = "k"})
local playerConnections = {}

local function livingPlayer(player)
	local character = player and player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if humanoid and root and humanoid.Health > 0 then
		return character, humanoid, root
	end
end

local function clearPath(state)
	if state.blockedConnection then
		state.blockedConnection:Disconnect()
		state.blockedConnection = nil
	end
	if state.path then
		state.path:Destroy()
		state.path = nil
	end
	state.waypoints = nil
	state.waypointIndex = nil
end

local function acquire(state, player, reason)
	if not livingPlayer(player) or state.humanoid.Health <= 0 then return end
	if state.target ~= player then
		state.target = player
		state.needsPath = true
	end
	state.lastDetected = os.clock()
	state.npc:SetAttribute("State", "Chase")
	state.npc:SetAttribute("TargetUserId", player.UserId)
	state.npc:SetAttribute("LastDetection", reason)
	state.humanoid.WalkSpeed = Config.ChaseSpeed
end

-- WeaponLastShot is written only after SurvivalWeaponServer accepts a real shot.
-- All pistol shots can be heard, including shots beyond the 40-stud fog radius.
local function watchPlayer(player)
	if playerConnections[player] then return end
	playerConnections[player] = player:GetAttributeChangedSignal("WeaponLastShot"):Connect(function()
		for _, state in pairs(controllers) do
			if state.npc:IsDescendantOf(workspace) and state.humanoid.Health > 0 then
				acquire(state, player, "Gunshot")
			end
		end
	end)
end
Players.PlayerAdded:Connect(watchPlayer)
Players.PlayerRemoving:Connect(function(player)
	if playerConnections[player] then
		playerConnections[player]:Disconnect()
		playerConnections[player] = nil
	end
end)
for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end

local function patrolPoints(hospital, npc, rootHeight)
	local points = {}
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = {npc}
	for _, tile in ipairs(hospital:GetChildren()) do
		if tile:IsA("BasePart") and tile.Name == "CorridorFloor" then
			local top = tile.Position + Vector3.new(0,tile.Size.Y/2,0)
			local clear = true
			for _, obstacle in ipairs(workspace:GetPartBoundsInBox(
				CFrame.new(top + Vector3.new(0,Config.AgentHeight/2+0.1,0)),
				Vector3.new(Config.AgentRadius*2,Config.AgentHeight,Config.AgentRadius*2),
				overlap
			)) do
				if obstacle.CanCollide and obstacle:IsDescendantOf(hospital) then
					clear = false
					break
				end
			end
			if clear then table.insert(points, top + Vector3.new(0,rootHeight,0)) end
		end
	end
	return points
end

local function choosePatrol(state)
	local choices = {}
	for _, point in ipairs(state.points) do
		if (point - state.root.Position).Magnitude > 4 then
			table.insert(choices, point)
		end
	end
	if #choices == 0 then choices = state.points end
	state.patrolGoal = choices[random:NextInteger(1,#choices)]
	state.npc:SetAttribute("PatrolDestination", state.patrolGoal)
	state.needsPath = true
end

local function computePath(state, goal, now)
	state.lastCompute = now
	state.lastGoal = goal
	state.needsPath = false
	clearPath(state)
	local path = PathfindingService:CreatePath({
		AgentRadius = Config.AgentRadius,
		AgentHeight = Config.AgentHeight,
		AgentCanJump = false,
		AgentCanClimb = false,
		WaypointSpacing = Config.WaypointSpacing,
	})
	local ok = pcall(function()
		path:ComputeAsync(state.root.Position, goal)
	end)
	if not state.npc:IsDescendantOf(workspace) or state.humanoid.Health <= 0 then
		path:Destroy()
		return
	end
	state.npc:SetAttribute("LastPathStatus", ok and path.Status.Name or "ComputeError")
	state.npc:SetAttribute("PathReplans", (state.npc:GetAttribute("PathReplans") or 0)+1)
	if not ok or path.Status ~= Enum.PathStatus.Success then
		path:Destroy()
		state.retryAt = now + Config.PathRetrySeconds
		state.humanoid:MoveTo(state.root.Position)
		return
	end
	state.path = path
	state.waypoints = path:GetWaypoints()
	state.waypointIndex = math.min(2, #state.waypoints)
	state.blockedConnection = path.Blocked:Connect(function(index)
		if state.waypointIndex and index >= state.waypointIndex then
			state.needsPath = true
		end
	end)
	state.lastProgressPosition = state.root.Position
	state.lastProgressAt = now
	state.commandedIndex = nil
end

local function followPath(state)
	if not state.waypoints then return end
	local waypoint = state.waypoints[state.waypointIndex]
	while waypoint do
		local delta = waypoint.Position - state.root.Position
		local horizontal = Vector3.new(delta.X,0,delta.Z).Magnitude
		if horizontal > Config.WaypointReachDistance then break end
		state.waypointIndex = state.waypointIndex + 1
		waypoint = state.waypoints[state.waypointIndex]
	end
	if not waypoint then
		clearPath(state)
		return
	end
	if state.commandedIndex ~= state.waypointIndex then
		state.commandedIndex = state.waypointIndex
		state.humanoid:MoveTo(waypoint.Position)
	end
end

local function attack(state, targetCharacter, targetHumanoid, targetRoot, now)
	if (targetRoot.Position - state.root.Position).Magnitude > Config.AttackRange then return end
	if now - state.lastAttack < Config.AttackCooldown then return end
	local from = state.npc:FindFirstChild("Head") or state.root
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {state.npc}
	local hit = workspace:Raycast(from.Position, targetRoot.Position-from.Position, params)
	if hit and not hit.Instance:IsDescendantOf(targetCharacter) then return end
	state.lastAttack = now
	state.npc:SetAttribute("LastAttack", workspace:GetServerTimeNow())
	targetHumanoid:TakeDamage(Config.AttackDamage)
end

local function update(state)
	local now = os.clock()
	local targetCharacter, targetHumanoid, targetRoot = livingPlayer(state.target)
	-- Radius detection deliberately works through hospital partitions.
	if targetRoot and (targetRoot.Position-state.root.Position).Magnitude <= Config.DetectionRadius then
		state.lastDetected = now
	else
		local nearest, nearestDistance
		for _, player in ipairs(Players:GetPlayers()) do
			local _, _, root = livingPlayer(player)
			if root then
				local distance = (root.Position-state.root.Position).Magnitude
				if distance <= Config.DetectionRadius and (not nearestDistance or distance < nearestDistance) then
					nearest, nearestDistance = player, distance
				end
			end
		end
		if nearest then
			acquire(state, nearest, "Proximity")
			targetCharacter, targetHumanoid, targetRoot = livingPlayer(state.target)
		end
	end
	if state.target and (not targetRoot or now-state.lastDetected > Config.ChaseMemorySeconds) then
		state.target = nil
		state.patrolGoal = nil
		state.humanoid:MoveTo(state.root.Position)
		clearPath(state)
		state.npc:SetAttribute("State", "Patrol")
		state.npc:SetAttribute("TargetUserId", 0)
		state.humanoid.WalkSpeed = Config.PatrolSpeed
	end

	local goal
	if state.target and targetRoot then
		goal = targetRoot.Position
		attack(state, targetCharacter, targetHumanoid, targetRoot, now)
		if (goal-state.root.Position).Magnitude <= Config.AttackRange*0.8 then
			state.humanoid:MoveTo(state.root.Position)
			state.commandedIndex = nil
			return
		end
	else
		if not state.patrolGoal then
			if now < state.pauseUntil then return end
			choosePatrol(state)
		end
		goal = state.patrolGoal
		if (goal-state.root.Position).Magnitude <= 2 then
			state.patrolGoal = nil
			state.pauseUntil = now + random:NextNumber(Config.PatrolPauseMin,Config.PatrolPauseMax)
			state.humanoid:MoveTo(state.root.Position)
			clearPath(state)
			return
		end
	end

	if (state.root.Position-state.lastProgressPosition).Magnitude > 0.4 then
		state.lastProgressPosition = state.root.Position
		state.lastProgressAt = now
	elseif now-state.lastProgressAt > Config.StuckSeconds then
		state.needsPath = true
		state.lastProgressAt = now
		if not state.target then choosePatrol(state) goal = state.patrolGoal end
	end
	local movedGoal = state.lastGoal and (goal-state.lastGoal).Magnitude > Config.TargetMovedDistance
	if now >= state.retryAt and now-state.lastCompute >= Config.RepathInterval
		and (state.needsPath or not state.path or (state.target and movedGoal)) then
		computePath(state, goal, now)
	end
	followPath(state)
end

local function startHospital(hospital)
	if started[hospital] or hospital.Parent ~= workspace then return end
	started[hospital] = true
	local npc = hospital:FindFirstChild(Config.NPCName)
	if npc and not npc:GetAttribute("ManagedHospitalMutant") then
		warn("HospitalMutantAI: an unrelated NPC already uses the mutant name")
		return
	end
	local fresh = npc == nil
	npc = npc or template:Clone()
	npc.Name = Config.NPCName
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	local root = npc:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then warn("Mutant template has no Humanoid/root") return end
	npc.PrimaryPart = root
	local leg = npc:FindFirstChild("Left Leg")
	local rootHeight = humanoid.HipHeight + root.Size.Y/2 + (leg and leg.Size.Y or 0)
	local points = patrolPoints(hospital, npc, rootHeight)
	if #points == 0 then
		if fresh then npc:Destroy() end
		warn("HospitalMutantAI: no clear corridor patrol points")
		return
	end
	local landmark = hospital:FindFirstChild("MaternitySign")
	table.sort(points, function(a,b)
		local center = landmark and landmark.Position or hospital:GetModelCFrame().Position
		return (a-center).Magnitude < (b-center).Magnitude
	end)
	if fresh then
		npc:SetPrimaryPartCFrame(CFrame.lookAt(points[1]+Vector3.new(0,0.05,0), points[1]+Vector3.new(0,0.05,1)))
		npc.Parent = hospital
	end
	for _, part in ipairs(npc:GetDescendants()) do
		if part:IsA("BasePart") then part.Anchored = false end
	end
	local canOwn = root:CanSetNetworkOwnership()
	if canOwn then root:SetNetworkOwner(nil) end
	humanoid.MaxHealth = Config.MaxHealth
	humanoid.Health = Config.MaxHealth
	humanoid.WalkSpeed = Config.PatrolSpeed
	humanoid.AutoRotate = true
	humanoid.BreakJointsOnDeath = false
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Jumping, false)
	npc:SetAttribute("State", "Patrol")
	npc:SetAttribute("TargetUserId", 0)
	npc:SetAttribute("DetectionRadius", Config.DetectionRadius)
	npc:SetAttribute("PatrolPointCount", #points)
	local state = {
		npc = npc, humanoid = humanoid, root = root, points = points,
		lastDetected = 0, lastCompute = -math.huge, retryAt = 0,
		lastAttack = -math.huge, pauseUntil = 0,
		lastProgressPosition = root.Position, lastProgressAt = os.clock(),
	}
	controllers[hospital] = state
	task.spawn(function()
		while hospital.Parent == workspace and npc:IsDescendantOf(hospital) and humanoid.Health > 0 do
			update(state)
			task.wait(Config.ThinkInterval)
		end
		clearPath(state)
		if npc.Parent then
			npc:SetAttribute("State", humanoid.Health <= 0 and "Dead" or "Inactive")
			npc:SetAttribute("TargetUserId", 0)
			humanoid:MoveTo(root.Position)
		end
		controllers[hospital] = nil
	end)
end

-- HospitalLayout replaces its generated model at startup; support both ordering cases.
workspace.ChildAdded:Connect(function(child)
	if child.Name == Config.HospitalName and child:IsA("Model") then
		task.delay(0.25, startHospital, child)
	end
end)
local hospital = workspace:FindFirstChild(Config.HospitalName)
if hospital then task.delay(0.25, startHospital, hospital) end
]]></ProtectedString>
